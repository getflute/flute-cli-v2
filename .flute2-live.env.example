# Copy to .flute2-live.env, fill in sandbox values, then: source .flute2-live.env
#
# The unattended run, which is the one to start with:
#   cargo test --test live -- --ignored --test-threads=1 \
#       --skip attended --skip irreversible --skip needs_terminal
# See the module documentation in tests/live.rs for what the name suffixes mean
# and why the thread count is fixed.
#
# A shell file rather than TOML, because the loader reads the environment and
# nothing parses a config file. `KEY = "value"` is not shell assignment and
# `source` would not export it.
# Most of these are readable from the API. The suite does not read them
# for you on purpose — discovering them at run time would couple every
# transaction scenario to `settings payment-config`, so one broken read would
# fail eight unrelated scenarios for the wrong reason. Each scenario names the
# command in its own failure message; they are repeated here so you can fill
# this in before hitting one.

# Two processors, not one: `settings payment-config` ->
# availablePaymentProcessors[]. Take the paymentProcessorId of the one whose
# type is SandboxCard/Tsys and the one whose type is SandboxAch/Ach.
#
# Both report isDefault, because that flag is per payment method rather than
# per account, so one variable cannot cover both. Sending an ACH request to
# the card processor fails for a reason that looks nothing like the cause.
export FLUTE2_LIVE_CARD_PROCESSOR_ID=00000000-0000-0000-0000-000000000000
export FLUTE2_LIVE_ACH_PROCESSOR_ID=00000000-0000-0000-0000-000000000000

# `terminals list` shows merchantId on every row; so does `api-keys list`.
export FLUTE2_LIVE_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# `terminals list` -> the ID of a row whose MODE is SemiIntegrated and whose
# LINE is Online. POS cannot use a terminal in any other mode, and an offline
# one fails every POS scenario for a reason that is not the CLI's.
export FLUTE2_LIVE_TERMINAL_ID=00000000-0000-0000-0000-000000000000

# The one value the API cannot hand back: v2 declares no device endpoints at
# all. It is the external identifier configured on the terminal itself.
export FLUTE2_LIVE_POS_DEVICE_ID=POS-DEVICE-001

# Your own mobile number in E.164 form, or your own email address. A live
# share reaches a real inbox or handset, so the scenarios have no literal to
# fall back on: leave this unset and they refuse to run rather than texting
# somebody else's number. Only the two `_attended` share scenarios read it.
export FLUTE2_LIVE_SHARE_RECIPIENT=+10000000000

# Credentials. `load_with_env_fallback` reads these *before* the keychain, so
# filling them in here bypasses the store completely.
#
# **Fill them in for any run you are not watching.** A keychain grant on macOS
# is bound to the binary, and `cargo test` rebuilds — a rebuilt
# target/debug/flute2 is a different application to the OS, so its access is
# gone and every scenario fails with "Platform secure storage failure: User
# canceled the operation" after waiting on a prompt nobody answers.
#
# For interactive use the keychain is the better home for a secret:
#
#   ./target/debug/flute2 auth login
#
# Nothing installs `flute2`, so that is the built binary rather than a command
# on PATH. The keychain entry is keyed by service and profile, so any build
# writes the entry any other build reads.
export FLUTE2_CLIENT_ID=
export FLUTE2_CLIENT_SECRET=
